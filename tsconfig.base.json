{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "baseUrl": "./",
    "paths": {
      "@editor/*": ["apps/editor/src/*"],
      "@admin/*": ["apps/admin/src/*"],
      "@shared/*": ["libs/shared/src/*"]
    }
  }
}
